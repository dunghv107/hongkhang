# Public site URL (custom Cloudflare domain in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API / Connect
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Cloudinary — Console > API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vercel automatically supplies VERCEL_URL and
# VERCEL_PROJECT_PRODUCTION_URL during deployments.
